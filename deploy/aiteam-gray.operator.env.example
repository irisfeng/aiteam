# Compose interpolation only. Copy outside the repository and keep the release SHA pinned.
AITEAM_COMPOSE_PROJECT=aiteam-gray
AITEAM_CONTAINER_NAME=aiteam-gray
AITEAM_RELEASE_SHA=
AITEAM_IMAGE=local/aiteam:replace-with-release-sha
# Before a VPS build, replace the mutable tag with the verified upstream digest.
AITEAM_NODE_IMAGE=node:22.14.0-bookworm-slim
AITEAM_GRAY_HOST_PORT=18787
AITEAM_GRAY_DATA_DIR=/srv/aiteam-gray/data
AITEAM_GRAY_SECRETS_FILE=/srv/aiteam-gray/secrets/aiteam.env
AITEAM_GRAY_NETWORK=coworker-aiteam-gray
COWORKER_INTERNAL_URL=http://coworker-web:3000
