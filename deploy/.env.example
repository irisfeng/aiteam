# ── 统一 Web App（Coworker + AiTeam）单主机部署环境变量 ──
# 把本文件复制为各自进程的环境（或 .env），按部署平台填写。

# ===== 两个进程共享 =====
# NextAuth 会话密钥：Coworker 用它签发会话，AiTeam 用它本地解密会话 cookie（走 Coworker 鉴权的命门）
# 两边必须完全一致。生成：openssl rand -base64 32
AUTH_SECRET=

# ===== AiTeam（server，常驻 Node 进程，默认 :8787）=====
# coworker = 复用 Coworker 登录态 + 每用户隔离工作区；standalone = 原始单机单用户
AITEAM_AUTH_MODE=coworker
# 真实 AI 能力的前提（不填则为 mock 演示模式）
ANTHROPIC_API_KEY=
# 可选：模型分级 / 预算护栏
# AITEAM_STRONG_MODEL=claude-opus-4-8
# AITEAM_LIGHT_MODEL=claude-haiku-4-5
# AITEAM_DAILY_TOKEN_BUDGET=0
PORT=8787

# ===== Coworker（Next.js，默认 :3000）=====
# 显示 AiTeam 顶部切换 tab（不部署 AiTeam 时留空即回到纯 Coworker）
NEXT_PUBLIC_AITEAM_ENABLED=1
# Coworker 自身依赖（见 coworker/CLAUDE.md）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ENCRYPTION_KEY=
RESEND_API_KEY=
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
